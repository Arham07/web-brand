# Contact form → email delivery (Hostinger SMTP).
#
# Local dev:  copy this to .env.local (gitignored) and fill SMTP_PASS.
# Production: hPanel → your site → Environment variables. Saving there
#             redeploys the app automatically, which is what makes the new
#             values visible — the process only reads the environment at boot.
#             .env.local is NOT deployed; hPanel is the only production source.
#
# Find these in hPanel → Emails → <your mailbox> → Configuration settings.

SMTP_HOST=smtp.hostinger.com

# 465 = implicit SSL. Use 587 only if your panel says STARTTLS.
SMTP_PORT=465

# The FULL address, not just "info". This is also the From: address —
# Hostinger refuses to send as any mailbox other than the authenticated one,
# and a visitor's address in From: would fail SPF and land in spam.
SMTP_USER=info@americanwebguild.com

SMTP_PASS=

# Where leads land. Deliberately separate from SMTP_USER: if info@ forwards to
# Gmail, mail "from yourself" that didn't originate at Google looks suspicious
# to Gmail's filter. If leads start landing in spam, point this at a different
# mailbox and leave SMTP_USER alone.
CONTACT_TO_EMAIL=info@americanwebguild.com
